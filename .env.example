# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard → Connect)
DATABASE_URL=


# Better Auth: random secret (openssl rand -base64 32) and the app origin
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Local test account for manual/E2E checks (dev only)
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
